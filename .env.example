# Chat/ticket storage (dashboard/db.py) — a real Postgres instance, not
# SQLite: a Devtron/Kubernetes pod's filesystem is ephemeral, so a local
# .db file gets wiped on every redeploy/restart. Standard libpq URL:
# postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://astrobot:astrobot@localhost:5432/astro_conversion_bot

# Gemini via Vertex AI (service-account auth) — without this, /ask falls
# back to the rule-based responder. Paste the full service-account JSON as
# the value (same convention as astrohelp) — NEVER commit a real value here,
# this file only holds a blank placeholder. project_id is read off the JSON
# itself, no separate project var needed.
GEMINI_VERTEX_CREDENTIALS_JSON=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.0-flash-001
GEMINI_BILLING_FEATURE=astro_conversion_bot

# S3 analytics logging (conversion-funnel events, queried by Redash) —
# without S3_BUCKET, events are appended to logs/events.jsonl instead
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=
S3_PREFIX=astro-conversion-bot/events

# Real Redash "astrologer availability" query (integrations/redash_client.py
# get_astrologer_availability) — is_online_now + predicted_next_available_utc
# per expert_id. Without REDASH_AVAILABILITY_API_KEY, astrologer availability
# stays on the mocked data in recommend_flow_client.py.
REDASH_AVAILABILITY_API_KEY=
REDASH_AVAILABILITY_QUERY_ID=20369

# Real coin-credit call (integrations/coin_credit_client.py) — direct
# call to AstroLokal's system-transactions API. Defaults to production
# (api.astrolokal.com) — no dev environment/credential is available.
# THIS MOVES REAL MONEY — leave COIN_CREDIT_API_AUTH blank until you've
# confirmed a safe way to test (a designated test user + trivial
# amount). Blank = every credit_coins call stays mocked (logged, not
# sent). Value is the base64 "user:pass" that goes after "Basic " in
# the Authorization header — never commit a real one.
COIN_CREDIT_API_URL=https://api.astrolokal.com/v1/system-transactions/
COIN_CREDIT_API_AUTH=

# Admin dashboard (/admin) — Google sign-in. Create an OAuth 2.0 "Web
# application" client in Google Cloud Console and add the site's origin
# (e.g. https://astro-customer-support.astrolokal.com) under Authorized
# JavaScript origins. Allow people by exact email and/or by whole Google
# Workspace domain; the dashboard stays disabled until the client ID and
# at least one of these is set.
GOOGLE_OAUTH_CLIENT_ID=
ADMIN_ALLOWED_EMAILS=
ADMIN_ALLOWED_DOMAIN=
# Signs the admin login cookie — set it so logins survive restarts.
ADMIN_SESSION_SECRET=
