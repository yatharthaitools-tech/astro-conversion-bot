# Admin dashboard login (dashboard/auth.py) — real per-person email+
# password accounts with roles (Admin/Support Agent/Analyst), managed
# from the dashboard's own Users page once someone's logged in. These two
# only seed the very FIRST Admin account, on first startup when no
# admin_users exist yet — after that, they're unused (safe to leave set,
# or to blank out once you have another Admin who can create more).
# Blank + no admin_users row yet = the dashboard is unreachable, not open.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Signs the admin dashboard's session cookie. Optional — without it, the
# app generates a real random value once and stores it in Postgres
# (dashboard_config table), shared automatically by every worker/pod. Set
# this only if you want to pin a specific known value yourself.
ADMIN_SESSION_SECRET=

# Chat/ticket storage (dashboard/db.py) — a real Postgres instance, not
# SQLite: a Devtron/Kubernetes pod's filesystem is ephemeral, so a local
# .db file gets wiped on every redeploy/restart. Standard libpq URL:
# postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://astrobot:astrobot@localhost:5432/astro_conversion_bot

# Gemini via Vertex AI (service-account auth) — without this, /ask falls
# back to the rule-based responder. Paste the full service-account JSON as
# the value (same convention as astrohelp) — NEVER commit a real value here,
# this file only holds a blank placeholder. project_id is read off the JSON
# itself, no separate project var needed.
GEMINI_VERTEX_CREDENTIALS_JSON=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.0-flash-001
GEMINI_BILLING_FEATURE=astro_conversion_bot

# S3 analytics logging (conversion-funnel events, queried by Redash) —
# without S3_BUCKET, events are appended to logs/events.jsonl instead
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=
S3_PREFIX=astro-conversion-bot/events

# Real Redash "astrologer availability" query (integrations/redash_client.py
# get_astrologer_availability) — is_online_now + predicted_next_available_utc
# per expert_id. Without REDASH_AVAILABILITY_API_KEY, astrologer availability
# stays on the mocked data in recommend_flow_client.py.
REDASH_AVAILABILITY_API_KEY=
REDASH_AVAILABILITY_QUERY_ID=20369

# Real coin-credit call (integrations/coin_credit_client.py) — direct
# call to AstroLokal's system-transactions API. Defaults to production
# (api.astrolokal.com) — no dev environment/credential is available.
# THIS MOVES REAL MONEY — leave COIN_CREDIT_API_AUTH blank until you've
# confirmed a safe way to test (a designated test user + trivial
# amount). Blank = every credit_coins call stays mocked (logged, not
# sent). Value is the base64 "user:pass" that goes after "Basic " in
# the Authorization header — never commit a real one.
COIN_CREDIT_API_URL=https://api.astrolokal.com/v1/system-transactions/
COIN_CREDIT_API_AUTH=

# Zoho Desk (integrations/zoho_client.py) — raises real tickets when
# ZOHO_MOCK_MODE is explicitly "false"; any other value (or unset) keeps
# every ticket mocked (logged, not sent to Zoho). See that file's own
# docstring before flipping this — the category/sub-issue picklist labels
# and customFields keys are guesses, not verified against your real
# portal yet.
ZOHO_MOCK_MODE=true
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.in
ZOHO_API_DOMAIN=https://desk.zoho.in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
ZOHO_DEPARTMENT_ID=

# Required for /webhooks/zoho — an agent's status/category/reply change in
# Zoho Desk reflecting back into this dashboard and the visitor's own
# chat (see app.py's zoho_webhook() docstring for the exact JSON body to
# configure as that webhook's template in Zoho Desk's Setup > Automation
# > Webhooks, and the custom header carrying this same value). Blank =
# the endpoint rejects every request — Zoho sync stays one-way (push
# only) until this is set.
ZOHO_WEBHOOK_SECRET=
