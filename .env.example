# Gemini API — without this, /ask falls back to the rule-based responder
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# S3 analytics logging (conversion-funnel events, queried by Redash) —
# without S3_BUCKET, events are appended to logs/events.jsonl instead
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=
S3_PREFIX=astro-conversion-bot/events
